# 环境配置示例文件
# 复制此文件为 .env 并修改相应的配置值

# 数据库配置
DATABASE_URL=sqlite:///./movie_system.db
# 或者使用 PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost/movie_db

# 数据库安全选项
# 警告: 设置为 true 会在每次启动时重新创建数据库表，会丢失所有数据!
RECREATE_DB=false

# JWT 安全配置
SECRET_KEY=your-very-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API 配置
API_V1_STR=/api/v1

# Redis 配置（用于 Celery）
REDIS_URL=redis://localhost:6379/0

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 第三方 API 配置（可选）
TMDB_API_KEY=your-tmdb-api-key
OMDB_API_KEY=your-omdb-api-key

# 日志级别
LOG_LEVEL=INFO

# 跨域配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
