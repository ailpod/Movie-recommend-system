# ======================================
# Movie Recommendation System 环境变量示例
# 复制此文件为 .env 并根据需要修改配置
# ======================================

# 安全密钥（生产环境必须修改！）
SECRET_KEY=your-super-secret-key-change-in-production-use-random-string

# OpenAI API Key（如果需要 AI 功能）
OPENAI_API_KEY=sk-your-openai-api-key-here

# 数据库配置（使用 Docker 时自动配置，本地开发时可修改）
# DATABASE_URL=postgresql://movieuser:moviepass@localhost:5432/moviedb

# Redis 配置（使用 Docker 时自动配置，本地开发时可修改）
# REDIS_URL=redis://localhost:6379/0

# 应用配置
# APP_DEBUG=false
# APP_TITLE=电影推荐系统 API
# APP_VERSION=1.0.0

# CORS 配置
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 认证配置
# SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
# SECURITY_ALGORITHM=HS256
